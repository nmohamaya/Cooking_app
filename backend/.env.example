# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Logging
LOG_LEVEL=debug

# GitHub Copilot Integration (Phase 3)
# GitHub token with Copilot access for Claude model usage
# Generate at: https://github.com/settings/tokens
# Includes access to Claude 3.5 Haiku and other models
GITHUB_TOKEN=your_github_token_here

# File Upload
MAX_FILE_SIZE=500MB
UPLOAD_DIR=./temp/uploads

# CORS Configuration
CORS_ORIGIN=*

# Video Processing (Phase 2)
VIDEO_TIMEOUT_MINUTES=60
MAX_VIDEO_DURATION_HOURS=1

# AI Model Configuration
# Model used for recipe extraction via GitHub Models API
AI_MODEL=gpt-4o
AI_API_URL=https://models.inference.ai.azure.com

# Cost Tracking (Phase 3)
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD=1.00
