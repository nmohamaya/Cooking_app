#!/bin/sh
# Pre-commit hook - runs tests and security checks before committing

REPO_ROOT=$(git rev-parse --show-toplevel)

echo "🔍 Running pre-commit checks..."

# --- Contract schema change detection ---
CONTRACT_FILES=$(git diff --cached --name-only -- 'contracts/*.schema.json')
if [ -n "$CONTRACT_FILES" ]; then
  echo "📋 Contract schema changes detected — validating..."
  echo "   Changed: $CONTRACT_FILES"

  cd "$REPO_ROOT/backend"
  JEST_OUTPUT=$(mktemp)
  if ! npx jest tests/contractValidation.test.js tests/agent-knowledge.test.js --bail --no-cache >"$JEST_OUTPUT" 2>&1; then
    tail -5 "$JEST_OUTPUT"
    rm -f "$JEST_OUTPUT"
    echo "❌ Contract validation tests failed. Commit aborted."
    echo "   Fix the schema or update tests to match."
    exit 1
  fi
  rm -f "$JEST_OUTPUT"
  echo "✅ Contract schemas valid"
fi

# --- Frontend tests ---
cd "$REPO_ROOT/MyRecipeApp"

echo "📝 Running tests..."
npm test -- --passWithNoTests --bail
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Commit aborted."
  exit 1
fi

# Run security audit
echo "🔒 Running security audit..."
npm run security
if [ $? -ne 0 ]; then
  echo "⚠️  Security audit found issues"
  exit 1
fi

echo "✅ All pre-commit checks passed!"
exit 0
